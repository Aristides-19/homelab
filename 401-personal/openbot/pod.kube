[Unit]
Description=OpenBot Server (Podman KUBE)
After=network-online.target

[Kube]
Yaml=/opt/openbot/pod.yaml
ConfigMap=/opt/openbot/env.yaml
# Podman cannot set these from a .kube unit or from kube play. See openbot.conf.
ContainersConfModule=/opt/openbot/openbot.conf

[Install]
WantedBy=multi-user.target
