[OPTIONS]

enable: 1

[ALIASES]

HomeLXC 10.0.4.18
LocalMobile 192.168.0.43
LocalPC 192.168.0.42
TailscaleMobile 100.64.1.2
TailscalePC 100.64.1.1

[IPSET admins]

dc/localmobile
dc/localpc
dc/tailscalemobile
dc/tailscalepc

[group ping]

IN Ping(ACCEPT) -source +dc/admins -log nolog

[group ssh]

IN SSH(ACCEPT) -source +dc/admins -log nolog

